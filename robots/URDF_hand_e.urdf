<joint name="joint1_base_yaw" type="continuous">
  <origin xyz="0 0 0.05" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="AD_80110_Base_v2_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
</joint>

<joint name="joint2_shoulder" type="continuous">
  <origin xyz="0.0725 8.3e-05 0.075" rpy="0 0 0"/>
  <parent link="ShoulderJoint_v1_1"/>
  <child link="AD_80110_J2_v2_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="rigid4" type="fixed">
  <origin xyz="0.0155 0.0 0.0" rpy="0 0 0"/>
  <parent link="AD_80110_J2_v2_1"/>
  <child link="Link1_urdf_v1_1"/>
