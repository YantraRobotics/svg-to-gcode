<?xml version="1.0" ?>
<!-- OWL 6.9 arm (identical kinematics to URDF_new.urdf) with the Robotiq
     Hand-E + D405 + soft-finger add-on from
     robots/hand_e/robotiq_hand-e_d405_soft_finger.urdf in place of the stamp
     demo tool. The gripper flange (hand_e_base) sits on the EE flange face
     36 mm along -Y, with gripper +X (fingers) along the tool axis (-Y) and
     +Z (camera) along +Z of end_effector_link. The fingers are articulated:
     prismatic joints finger_joint_1/2 (0..0.029 m, opposite axes) branch off
     hand_e_base, driven together from the gripper feedback (travel =
     gripper_position * 0.029). The base->Target chain stays 6-DOF: the
     finger joints are side branches, never on the controller's chain.
     The controller tip is the gripper target_frame. -->
<robot name="URDF_hand_e">

<mujoco>
  <compiler meshdir="../meshes" balanceinertia="true" discardvisual="false" strippath="true"/>
</mujoco>

<material name="silver">
  <color rgba="0.7 0.72 0.75 1.0"/>
</material>
<!-- 3D-printed covers: black PLA shells with the orange PLA inserts. -->
<material name="cover_black">
  <color rgba="0.16 0.16 0.17 1.0"/>
</material>
<material name="cover_orange">
  <color rgba="0.95 0.45 0.10 1.0"/>
</material>
<material name="steel_satin">
  <color rgba="0.6274509803921569 0.6274509803921569 0.6274509803921569 1.0"/>
</material>
<material name="opaque157207237">
  <color rgba="0.615686274509804 0.8117647058823529 0.9294117647058824 1.0"/>
</material>
<material name="opaque255242232">
  <color rgba="1.0 0.9490196078431372 0.9098039215686274 1.0"/>
</material>
<material name="opaque5997180">
  <color rgba="0.23137254901960785 0.3803921568627451 0.7058823529411765 1.0"/>
</material>
<material name="opaque203210238">
  <color rgba="0.796078431372549 0.8235294117647058 0.9333333333333333 1.0"/>
</material>

