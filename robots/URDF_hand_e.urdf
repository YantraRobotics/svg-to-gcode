<joint name="joint3_elbow" type="continuous">
  <origin xyz="-0.0155 0.0 0.0" rpy="0 0 0"/>
  <parent link="AD_80110_J3_v1_1"/>
  <child link="Link2_urdf_v1_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<!-- The shoulder bracket's bottom plate sits on the base actuator's small
     ring (85 mm) under its thick ring (110 mm), which stands inside the
     bracket: bottom up, small ring / plate / thick ring. The vendor CAD seats
     the plate on top of the thick ring instead, 35 mm higher (0.0455); the
     robot's shoulder axis is 135.5 mm above the base bottom, not 170.5. The
     visual origins below still place every mesh by the CAD offsets, so the
     shoulder and everything after it moves with this origin. -->
<joint name="rigid7" type="fixed">
  <origin xyz="0.0 0.0 0.0105" rpy="0 0 0"/>
  <parent link="AD_80110_Base_v2_1"/>
  <child link="ShoulderJoint_v1_1"/>
</joint>

<joint name="rigid8" type="fixed">
  <origin xyz="-0.050141 0.0 0.290217" rpy="0 0 0"/>
  <parent link="Link2_urdf_v1_1"/>
  <child link="AD_50070_J4_v2_1"/>
</joint>

<joint name="joint4_wrist_roll" type="continuous">
  <origin xyz="0.01 0.0 0.0" rpy="0 0 0"/>
  <parent link="AD_50070_J4_v2_1"/>
  <child link="Wrist_Link_urdf_v1_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="rigid28" type="fixed">
  <origin xyz="0.07875 0.000936 -0.06505" rpy="0 0 0"/>
  <parent link="Wrist_Link_urdf_v1_1"/>
  <child link="AD_50070_J4_v2_2"/>
</joint>

<!-- joint5 is the hardware wrist-pitch hinge. Origin is the same axis as
     before, restated in the motor-centered AD_50070_J4_v2_2 frame (the
     CAD export had parked that link 0.9 m off the housing). Axis, parent,
     and child are unchanged. -->
<joint name="joint5_wrist_pitch" type="continuous">
  <origin xyz="0 0 0.051534" rpy="0 0 0"/>
  <parent link="AD_50070_J4_v2_2"/>
  <child link="Wrist_Link_urdf_v1__1__1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="rigid30" type="fixed">
  <origin xyz="-0.000936 -0.0475 0.139766" rpy="0 0 0"/>
  <parent link="Wrist_Link_urdf_v1__1__1"/>
  <child link="AD_50070_J4_v2_3"/>
</joint>

<joint name="rigid31" type="fixed">
  <origin xyz="0 -0.0075 0" rpy="0 0 0"/>
  <parent link="AD_50070_J4_v2_3"/>
  <child link="wrist_adapter_link"/>
</joint>

<!-- joint6 is the hardware EE-rotate hinge. Same world axis as before;
     the origin is restated in the adapter's EE-face frame (identity
     because that face is the hinge). Axis, parent, and child are
     unchanged. -->
<joint name="joint6_ee_rotate" type="continuous">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="wrist_adapter_link"/>
  <child link="end_effector_link"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<!-- Robotiq Hand-E + D405 + soft fingers, welded to the EE flange.
     Geometry and frames come from robots/hand_e/robotiq_hand-e_d405_soft_finger.urdf
     (gripper base_link renamed hand_e_base to avoid colliding with the arm
     base). Gripper_Back_Plate sits on the EE flange; the housing flange is
     13.74 mm along gripper +X in the plate's circular pocket. Finger /
     slider / soft-finger meshes are placed at the add-on's zero prismatic
     stroke. camera_frame is the D405 back-face center, identity vs the
     housing; Camera is that same pose for existing tools. -->
<link name="hand_e_base">
  <inertial>
    <origin xyz="0.06822181297217005 4.278352133068836e-05 0.0068450046944859375" rpy="0 0 0"/>
    <mass value="2.840137567492122"/>
    <inertia ixx="0.00225149" iyy="0.00490899" izz="0.00416351" ixy="8.84262e-06" iyz="2.22788e-06" ixz="-0.000962826"/>
  </inertial>
  <visual>
    <origin xyz="0.099456 -0.000009 0.033992" rpy="0 1.57079632679 -1.57079632679"/>
    <geometry>
      <mesh filename="../meshes/hand_e/Gripper_Back_Plate_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_satin"/>
  </visual>
  <collision>
    <origin xyz="0.099456 -0.000009 0.033992" rpy="0 1.57079632679 -1.57079632679"/>
    <geometry>
      <mesh filename="../meshes/hand_e/Gripper_Back_Plate_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  <visual>
    <origin xyz="0.01374 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_satin"/>
  </visual>
  <collision>
    <origin xyz="0.01374 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  <visual>
    <origin xyz="0.09965636657714843 -1.906585693359375e-05 0.034" rpy="0 1.57079632679 -1.57079632679"/>
    <geometry>
      <mesh filename="../meshes/hand_e/D405_Adapter_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="opaque157207237"/>
  </visual>
  <collision>
    <origin xyz="0.09965636657714843 -1.906585693359375e-05 0.034" rpy="0 1.57079632679 -1.57079632679"/>
    <geometry>
      <mesh filename="../meshes/hand_e/D405_Adapter_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  <visual>
    <origin xyz="0.09965636657714843 -1.906585693359375e-05 0.034" rpy="0 1.57079632679 -1.57079632679"/>
    <geometry>
      <mesh filename="../meshes/hand_e/D405_Solid_v5_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="opaque203210238"/>
  </visual>
  <collision>
    <origin xyz="0.09965636657714843 -1.906585693359375e-05 0.034" rpy="0 1.57079632679 -1.57079632679"/>
    <geometry>
      <mesh filename="../meshes/hand_e/D405_Solid_v5_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<!-- Articulated Hand-E fingers, transplanted verbatim from
     robots/hand_e/robotiq_hand-e_d405_soft_finger.urdf (joints "Slider 3"
     and "Slider 4"; hand_e_base is frame-identical to its base_link, so
     origins/axes/limits are unchanged). Both joints travel 0..0.029 m and
     are driven together from the gripper feedback: travel =
     gripper_position (0 open .. 1 closed) * 0.029. The axes oppose, so
     the same value closes both fingers symmetrically. -->
<link name="finger_slider_1">
  <inertial>
    <origin xyz="0.012068874317543781 0.0510203918924256 0.009806833884144436" rpy="0 0 0"/>
    <mass value="0.5462954968262015"/>
    <inertia ixx="0.000786609" iyy="0.000177207" izz="0.00069794" ixy="-4.59875e-05" iyz="-2.43543e-05" ixz="-2.15485e-05"/>
  </inertial>
  <visual>
    <origin xyz="-0.019696 0.001916 -0.034655" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/ROBOTIQ_HAND-E_slider_v1_2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="opaque255242232"/>
  </visual>
  <collision>
    <origin xyz="-0.019696 0.001916 -0.034655" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/ROBOTIQ_HAND-E_slider_v1_2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  <visual>
    <origin xyz="-0.019696 0.001916 -0.034655" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/Finger_1_long_v18_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_satin"/>
  </visual>
  <collision>
    <origin xyz="-0.019696 0.001916 -0.034655" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/Finger_1_long_v18_1.stl" scale="0.001 0.001 0.001"/>
