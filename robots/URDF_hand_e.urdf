      <mesh filename="../meshes/hand_e/soft_gripper_finger_v1_2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="opaque5997180"/>
  </visual>
  <collision>
    <origin xyz="-0.019696 0.001916 -0.034655" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/hand_e/soft_gripper_finger_v1_2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

